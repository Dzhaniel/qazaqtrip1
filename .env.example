# ==== QazaqTrip environment variables (SERVER ONLY — never expose to the browser) ====

# OpenAI API key for the AI guide (/api/guide).
# If not set, the guide runs in DEMO MODE: the itinerary is built locally
# from src/data/cities/kyzylorda.json without any LLM call.
OPENAI_API_KEY=

# Optional: model name (default: gpt-4o-mini)
GUIDE_MODEL=gpt-4o-mini
